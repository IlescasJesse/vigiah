# Variables SOLO para producción (Vercel)
# No reemplaza tu .env local

# MySQL Railway (Prisma)
# Usa base vigiah_core (si no existe, créala con el script SQL de docs)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/vigiah_core"

# MongoDB Atlas
# Incluye nombre de base después del host
MONGODB_URI="mongodb+srv://USER:PASSWORD@HOST/vigiah?retryWrites=true&w=majority"

# Auth
JWT_SECRET="genera-un-secreto-largo-y-unico"
NEXTAUTH_SECRET="genera-otro-secreto-largo-y-unico"
NEXTAUTH_URL="https://TU-PROYECTO.vercel.app"